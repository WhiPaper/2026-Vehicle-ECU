# Project configuration defaults

# UART0 is reserved for the micro-ROS XRCE-DDS serial transport.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_MICRO_ROS_ESP_XRCE_DDS_MIDDLEWARE=y
CONFIG_MICRO_ROS_ESP_UART_TRANSPORT=y
CONFIG_MICROROS_UART_TXD=-1
CONFIG_MICROROS_UART_RXD=-1
CONFIG_MICROROS_UART_RTS=-1
CONFIG_MICROROS_UART_CTS=-1
CONFIG_ROS_UART_BAUD=921600
CONFIG_ROS_IMU_PUBLISH_RATE_HZ=50
CONFIG_ROS_DRIVE_PUBLISH_RATE_HZ=30
CONFIG_ROS_DIAGNOSTIC_PUBLISH_RATE_HZ=5
CONFIG_ROS_AGENT_PING_PERIOD_MS=500
CONFIG_ROS_TIME_SYNC_RETRY_MS=1000
CONFIG_ROS_PUBLISH_FAILURE_LIMIT=10
CONFIG_ROS_IMU_STALE_TIMEOUT_MS=100
CONFIG_ROS_DRIVE_STALE_TIMEOUT_MS=100
CONFIG_ROS_IMU_ANGULAR_VARIANCE_MICRO=1000
CONFIG_ROS_IMU_ACCEL_VARIANCE_MICRO=100000
CONFIG_ROS_ODOM_LINEAR_VARIANCE_MICRO=10000
CONFIG_ROS_ODOM_ANGULAR_VARIANCE_MICRO=20000

# Motor control
CONFIG_MOTOR_FRONT_LEFT_IA_GPIO=25
CONFIG_MOTOR_FRONT_LEFT_IB_GPIO=26
CONFIG_MOTOR_FRONT_RIGHT_IA_GPIO=27
CONFIG_MOTOR_FRONT_RIGHT_IB_GPIO=14
CONFIG_MOTOR_FRONT_RIGHT_INVERTED=y
CONFIG_MOTOR_REAR_LEFT_IA_GPIO=19
CONFIG_MOTOR_REAR_LEFT_IB_GPIO=18
CONFIG_MOTOR_REAR_RIGHT_IA_GPIO=17
CONFIG_MOTOR_REAR_RIGHT_IB_GPIO=16
CONFIG_MOTOR_REAR_RIGHT_INVERTED=y
CONFIG_MOTOR_PWM_FREQUENCY_HZ=20000
CONFIG_MOTOR_START_BOOST_SPEED=800
CONFIG_MOTOR_START_BOOST_DURATION_MS=100

# Encoder inputs
CONFIG_ENCODER_LEFT_A_GPIO=32
CONFIG_ENCODER_LEFT_B_GPIO=33
CONFIG_ENCODER_RIGHT_A_GPIO=34
CONFIG_ENCODER_RIGHT_B_GPIO=35
CONFIG_ENCODER_RIGHT_INVERTED=y
CONFIG_ENCODER_CPR=0
CONFIG_ENCODER_GLITCH_FILTER_NS=1000

# MPU6050 I2C and stationary calibration
CONFIG_MPU6050_SDA_GPIO=21
CONFIG_MPU6050_SCL_GPIO=22
CONFIG_MPU6050_I2C_ADDRESS=0x68
CONFIG_MPU6050_CALIBRATION_RATE_HZ=100
CONFIG_MPU6050_CALIBRATION_SAMPLES=200
CONFIG_IMU_I2C_TIMEOUT_MS=20
CONFIG_IMU_SAMPLE_RATE_HZ=50
CONFIG_IMU_RECOVERY_PERIOD_MS=1000

# Closed-loop driving remains disabled until these measured values and gains
# are configured for the physical vehicle.
CONFIG_DRIVE_WHEEL_RADIUS_MM=0
CONFIG_DRIVE_TRACK_WIDTH_MM=0
CONFIG_DRIVE_MAX_WHEEL_RPM=0
CONFIG_DRIVE_PID_KP_MILLI=0
CONFIG_DRIVE_PID_KI_MILLI=0
CONFIG_DRIVE_PID_KD_MILLI=0
CONFIG_DRIVE_CONTROL_PERIOD_MS=20
CONFIG_DRIVE_COMMAND_TIMEOUT_MS=500
CONFIG_DRIVE_STALL_TIMEOUT_MS=500
