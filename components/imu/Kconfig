menu "Vehicle IMU"

    config IMU_I2C_TIMEOUT_MS
        int "MPU6050 I2C transaction timeout (ms)"
        range 1 1000
        default 20

    config IMU_SAMPLE_RATE_HZ
        int "IMU acquisition rate (Hz)"
        range 1 200
        default 50

    config IMU_RECOVERY_PERIOD_MS
        int "IMU recovery retry period (ms)"
        range 100 10000
        default 1000

endmenu
