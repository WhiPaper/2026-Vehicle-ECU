menu "Vehicle micro-ROS"

    config ROS_UART_BAUD
        int "UART0 transport baud rate"
        range 115200 2000000
        default 921600

    config ROS_IMU_PUBLISH_RATE_HZ
        int "IMU publish rate (Hz)"
        range 1 200
        default 50

    config ROS_DRIVE_PUBLISH_RATE_HZ
        int "Odometry and joint state publish rate (Hz)"
        range 1 100
        default 30

    config ROS_DIAGNOSTIC_PUBLISH_RATE_HZ
        int "Diagnostics publish rate (Hz)"
        range 1 20
        default 5

    config ROS_AGENT_PING_PERIOD_MS
        int "Connected Agent ping period (ms)"
        range 100 5000
        default 500

    config ROS_TIME_SYNC_RETRY_MS
        int "ROS epoch synchronization retry period (ms)"
        range 100 10000
        default 1000

    config ROS_PUBLISH_FAILURE_LIMIT
        int "Consecutive publisher failures before reconnect"
        range 1 100
        default 10

    config ROS_IMU_STALE_TIMEOUT_MS
        int "Maximum IMU snapshot age (ms)"
        range 20 10000
        default 100

    config ROS_DRIVE_STALE_TIMEOUT_MS
        int "Maximum drive snapshot age (ms)"
        range 20 10000
        default 100

    config ROS_IMU_ANGULAR_VARIANCE_MICRO
        int "IMU angular velocity variance (micro-units)"
        range 1 1000000
        default 1000

    config ROS_IMU_ACCEL_VARIANCE_MICRO
        int "IMU linear acceleration variance (micro-units)"
        range 1 10000000
        default 100000

    config ROS_ODOM_LINEAR_VARIANCE_MICRO
        int "Wheel odometry linear variance (micro-units)"
        range 1 10000000
        default 10000

    config ROS_ODOM_ANGULAR_VARIANCE_MICRO
        int "Wheel odometry yaw variance (micro-units)"
        range 1 10000000
        default 20000

endmenu
